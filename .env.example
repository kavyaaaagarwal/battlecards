# ─────────────────────────────────────────────────────────────
#  Competitive Intelligence Agent — configuration
#  Copy to .env and fill in. Only COMPANY, COMPETITORS and one
#  LLM key are required; everything else has sensible defaults.
# ─────────────────────────────────────────────────────────────

# ── Subject company ─────────────────────────────────────────
COMPANY=
# Optional: skip auto-discovery of the official website
COMPANY_DOMAIN=

# Comma-separated. Optionally pin a domain with Name:domain
COMPETITORS=

# Optional but recommended: disambiguates generic names
# (e.g. "Notion" vs "notion") and sharpens search queries.
CATEGORY=

# ── LLM (pluggable) ─────────────────────────────────────────
# anthropic | openai | openrouter
LLM_PROVIDER=openrouter
# Blank picks the best free models automatically. Comma-separated = fallback order.
LLM_MODEL=
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint works with LLM_PROVIDER=openai.
# Free / near-free options:
#   Google Gemini (free tier):
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-2.5-flash      OPENAI_API_KEY=...
#   Groq (free tier):
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (local, free):
#     OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_API_KEY=ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# ── Web data ────────────────────────────────────────────────
# tavily | ddg | auto  (auto = tavily if TAVILY_API_KEY is set, else ddg)
SEARCH_PROVIDER=auto
# Free tier: 1,000 credits/month at https://tavily.com (~40-60 per run)
TAVILY_API_KEY=

# Results kept per search query (higher = richer, slower, pricier)
RESULTS_PER_QUERY=5
# Max characters kept per source page (keeps LLM cost down)
MAX_CHARS_PER_SOURCE=9000
# How long search/page results are cached locally
CACHE_TTL_HOURS=24

# ── Output ──────────────────────────────────────────────────
OUTPUT_DIR=reports
allow_runs=1

# ── Web app guardrails (fully open demo on free tiers) ───────
# New research runs allowed per day (identical same-day requests reuse a run for free)
RUNS_PER_DAY=30
# Tavily calls per day before falling back to DuckDuckGo (~28 per fresh run; free tier is 1,000/month)
TAVILY_CALLS_PER_DAY=150
# inline = background thread (local dev) · queue = Vercel Queues (deployed)
RUN_MODE=inline
