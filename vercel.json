{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "bindings": [{ "type": "service", "service": "intel", "format": "url", "env": "INTEL_URL" }]
    },
    "intel": {
      "root": "apps/intel",
      "entrypoint": "intel.api:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
